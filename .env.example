# Sotos OS — configuración del servidor (copiar a .env)

SOTOS_DOMAIN=os.midominio.com
PX_DOMAIN=px.midominio.com
OFFICE_DOMAIN=office.midominio.com

# secreto compartido entre Sotos y ONLYOFFICE (genera uno largo y aleatorio):
#   openssl rand -hex 32
OO_JWT_SECRET=

# open = cualquiera puede crear cuenta · closed = solo cuentas existentes
SOTOS_REGISTRATION=open
# espacio por cuenta, en MB
SOTOS_QUOTA_MB=2048
# versión de ONLYOFFICE Docs (fíjala tras probarla)
OO_VERSION=latest
