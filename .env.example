# Sotos — server configuration (copy to .env)
# © 2026 Sebastian Sotomontes

SOTOS_DOMAIN=os.example.com
PX_DOMAIN=px.example.com
OFFICE_DOMAIN=office.example.com

# secret shared by Sotos and ONLYOFFICE (generate a long random one):
#   openssl rand -hex 32
OO_JWT_SECRET=

# open = anyone can sign up · closed = existing accounts only
SOTOS_REGISTRATION=open
# per-account storage, in MB
SOTOS_QUOTA_MB=2048
# ONLYOFFICE Docs version (pin it once tested)
OO_VERSION=latest
