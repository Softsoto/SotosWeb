# Sotos — reverse proxy with automatic HTTPS
# © 2026 Sebastian Sotomontes

{$SOTOS_DOMAIN} {
	encode zstd gzip
	reverse_proxy sotos:8787 {
		flush_interval -1   # live events (SSE)
	}
}

# isolated origin for pages opened in the Sotos Browser
{$PX_DOMAIN} {
	reverse_proxy sotos:8787
}

{$OFFICE_DOMAIN} {
	reverse_proxy onlyoffice:80
}
