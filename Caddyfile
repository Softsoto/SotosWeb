# Sotos OS — proxy inverso con HTTPS automático
# © 2026 Sebastian Sotomontes

{$SOTOS_DOMAIN} {
	encode zstd gzip
	reverse_proxy sotos:8787 {
		flush_interval -1   # eventos en vivo (SSE)
	}
}

# origen aislado para las páginas abiertas desde el Navegador de Sotos
{$PX_DOMAIN} {
	reverse_proxy sotos:8787
}

{$OFFICE_DOMAIN} {
	reverse_proxy onlyoffice:80
}
